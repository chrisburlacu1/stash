<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stash">
        
        <!--
          singleTask: the default (standard) launch mode started a NEW MainActivity for every
          shared link, so Recents filled with Stash instances and each one built its own
          repository and Gemini Nano client. With singleTask the existing instance is reused and
          shares arrive via onNewIntent instead.
        -->
        <!--
          adjustNothing, not the platform default (adjustResize).

          With adjustResize the *window* shrinks when the keyboard opens, so every layout inside
          it — header, transcript, the chat's root Box — is measured against a smaller canvas and
          moves. No amount of moving imePadding() around in Compose can undo that: the space is
          already gone before composition sees it. The chat screen wants the opposite contract:
          the window keeps its full height, the keyboard simply covers the bottom of it, and
          WindowInsets.ime reports how much is covered so that exactly one composable (the chat
          composer) consumes it and translates up. Everything else stays where it was.

          This is the standard pairing for enableEdgeToEdge() in MainActivity.
        -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
