<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Package visibility filtering (Android 11+, and we target 36) hides other installed apps
      unless they are declared here. Without this, resolveActivity() for the Gemini app returns
      null even though it is installed, and "Open in Gemini" silently degrades to the system
      chooser — which is the fallback working correctly for the wrong reason.

      Note ADB cannot reveal this: the shell is exempt from visibility filtering, so the same
      explicit intent that fails from the app succeeds from `adb shell am start`.

      Declared narrowly by package rather than with QUERY_ALL_PACKAGES: we need to see exactly one
      app, and the broad permission is both unjustifiable for this and Play-policy restricted.
      (The ML Kit GenAI dependency does the same thing for com.google.android.aicore.)
    -->
    <queries>
        <package android:name="com.google.android.apps.bard" />
    </queries>

    <!--
      allowBackup is false, not stub <exclude> rules. This is a privacy-first app: the Room
      database, DataStore preferences and cached header images would otherwise all be eligible
      for Google's cloud backup by default, which contradicts "no data leaves the device" (see
      CLAUDE.md, Security & Data). backup_rules.xml / data_extraction_rules.xml are kept as
      inert templates in case a future workstream wants a narrower, explicit allow-list instead
      of blocking backup outright — they are not referenced while allowBackup is false.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Stash">
        
        <!--
          singleTask: the default (standard) launch mode started a NEW MainActivity for every
          shared link, so Recents filled with Stash instances and each one built its own
          repository and Gemini Nano client. With singleTask the existing instance is reused and
          shares arrive via onNewIntent instead.
        -->
        <!--
          adjustNothing, not the platform default (adjustResize).

          With adjustResize the *window* shrinks when the keyboard opens, so every layout inside
          it — header, transcript, the chat's root Box — is measured against a smaller canvas and
          moves. No amount of moving imePadding() around in Compose can undo that: the space is
          already gone before composition sees it. The chat screen wants the opposite contract:
          the window keeps its full height, the keyboard simply covers the bottom of it, and
          WindowInsets.ime reports how much is covered so that exactly one composable (the chat
          composer) consumes it and translates up. Everything else stays where it was.

          This is the standard pairing for enableEdgeToEdge() in MainActivity.
        -->
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
