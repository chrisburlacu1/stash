<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      The window theme, applied before Compose draws anything.

      This is the only surface Compose does not own: it paints the window between launch and the
      first frame of StashTheme. It was the stock template theme — Material Components (M2), an
      action bar, and a hard-coded purple status bar that belonged to no palette in the app.

      Now it is transparent and chromeless, so the launch window is the app's own background rather
      than a colour flashing before the real one. MainActivity calls enableEdgeToEdge(), which owns
      the system bars from the first frame; anything set here would only fight it.
    -->
    <style name="Theme.Stash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
