<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The launch window's background, and the only colour defined in XML.

      It must match `surfaceLight` in Color.kt: this is what the window shows between launch and
      Compose's first frame, so any difference reads as a flash of the wrong colour. If the seed
      changes, change this with it.

      Everything else the app draws comes from the Compose ColorScheme. The stock purple_500 /
      teal_200 template stubs that used to live here are gone along with the M2 theme that
      referenced them.
    -->
    <color name="window_background">#FFFBFC</color>
</resources>
